# ── BambooHR ────────────────────────────────────────────────────────────────
# Your BambooHR subdomain: https://<subdomain>.bamboohr.com
BAMBOOHR_SUBDOMAIN=
# API key: BambooHR → your avatar → "API Keys" → Add New Key
BAMBOOHR_API_KEY=

# If both values above are empty the app runs in DEMO MODE with sample data,
# so you can explore the UI before wiring up your account.

# ── Email (SMTP) ────────────────────────────────────────────────────────────
# Used to send the onboarding packet to new hires. If left empty, packet
# sends are simulated (PDFs are still generated and downloadable).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# From address for outgoing mail, e.g. "People Ops <people@yourco.com>"
MAIL_FROM=
# Optional: HR address to CC on every packet
MAIL_CC=

# ── Company branding used in generated documents ────────────────────────────
COMPANY_NAME=WPI Inc.
COMPANY_ADDRESS=7602 University Ave, Lubbock, Texas 79423
HR_CONTACT_NAME=WPI Onboarding
HR_CONTACT_EMAIL=people@yourco.com

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
